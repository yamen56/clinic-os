# Cloudflare Pages headers.
#
# Canonical as an HTTP header rather than a <link> tag, because the site is
# deployed by direct upload and this needs no HTML editing. Google treats
# Link: rel="canonical" as equivalent to the tag.
#
# Why it matters here: without it, /demo and /demo?utm_source=anything look like
# two separate pages competing with each other, and www vs apex looked like two
# separate sites until the redirect rule went in.

/
  Link: <https://clinicti.app/>; rel="canonical"

/demo
  Link: <https://clinicti.app/demo>; rel="canonical"

/booking
  Link: <https://clinicti.app/booking>; rel="canonical"

/dashboard
  Link: <https://clinicti.app/dashboard>; rel="canonical"

/patients
  Link: <https://clinicti.app/patients>; rel="canonical"

/documents
  Link: <https://clinicti.app/documents>; rel="canonical"

/payments
  Link: <https://clinicti.app/payments>; rel="canonical"

/automations
  Link: <https://clinicti.app/automations>; rel="canonical"

/assistant
  Link: <https://clinicti.app/assistant>; rel="canonical"

# Static assets can be cached hard — they are content-hashed or rarely change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
