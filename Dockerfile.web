# Next.js web app, containerised.
#
# Runs as a long-lived server rather than serverless functions. That removes the
# per-deployment function cap, and lets the realtime endpoint hold a Postgres
# LISTEN connection for as long as the browser stays open instead of being cut
# off at the platform's streaming limit.
#
# Invoice PDFs are still rendered by the worker, so no Chromium is needed here.
FROM node:22-slim

WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# The worker owns PDF rendering; this image never launches a browser.
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# Dev dependencies are needed to build (TypeScript, Tailwind), so install the
# full tree, build, then prune. Layer-cached separately from source changes.
COPY package*.json ./
# Both scripts, not just the entry point: postinstall requires copy-pdf-worker,
# and a missing require here fails `npm ci` and takes the whole build with it.
COPY scripts/postinstall.js scripts/copy-pdf-worker.js ./scripts/
RUN npm ci --include=dev

COPY . .

# NEXT_PUBLIC_* is inlined at build time, so it must be present now — not at run.
ARG NEXT_PUBLIC_VAPID_PUBLIC_KEY
ENV NEXT_PUBLIC_VAPID_PUBLIC_KEY=$NEXT_PUBLIC_VAPID_PUBLIC_KEY
RUN npm run build && npm prune --omit=dev && npm cache clean --force

EXPOSE 3000
CMD ["npx", "next", "start", "-p", "3000"]
