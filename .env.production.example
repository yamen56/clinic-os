# Production environment.
#
# Three services, three sets of variables. See DEPLOY.md for the walkthrough.
#   clinic-web  → the Next.js app
#   clinic-os   → the worker (WhatsApp, automations, AI, reminders, invoice PDFs)
#   Postgres-EU → the database
#
# All three are Railway services in one project; files live in Cloudflare R2.
# Anything marked [both] must be IDENTICAL on the web and worker services or the
# two will not trust each other.

# ---------------------------------------------------------------- database
# [both] App connection. Uses the clinicos_app role so RLS applies — never the
# postgres superuser, which would bypass tenant isolation.
# Take the Postgres service connection string, then swap the user/password for
# clinicos_app.
DATABASE_URL=postgresql://clinicos_app:APP_DB_PASSWORD@HOST:PORT/railway

# Owner connection, used ONLY to run migrations. Worker service only — the web
# service has no business holding superuser credentials.
DATABASE_SUPER_URL=postgresql://postgres:DB_PASSWORD@HOST:PORT/railway

# Password assigned to the clinicos_app role when migrations run.
# Must match the password inside DATABASE_URL above.
APP_DB_PASSWORD=generate-a-long-random-password

# ------------------------------------------------------------------ urls
# [both] Public address of the web app. The worker fetches invoice print pages
# from here, and booking/invoice links are built from it.
APP_URL=https://your-app-domain

# [both] Public address of the worker. The web service calls it to render PDFs
# and to start WhatsApp sessions.
WORKER_URL=https://your-worker.up.railway.app

# ---------------------------------------------------------------- secrets
# [both] Shared secret guarding the worker's internal API. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_API_SECRET=

# Signs session cookies. Rotating this logs everyone out. Web only.
SESSION_SECRET=

# --------------------------------------------------------------- storage
# [both] Cloudflare R2, which is S3-compatible. Create a PRIVATE bucket named
# "clinic-files" and an S3 API token for it. Files are served through the app,
# which checks clinic membership first — the bucket must stay private.
S3_BUCKET=clinic-files
S3_ENDPOINT=https://ACCOUNT_ID.eu.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------- ai
# Worker only — the AI receptionist runs there. Leave empty to keep the agent
# off; it escalates to staff instead of answering.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---------------------------------------------------------------- push
# [both] Web push. Reuse the keys already in your local .env, or regenerate:
#   npx web-push generate-vapid-keys
# Changing them invalidates every existing subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ---------------------------------------------------------------- email
# [both] Resend. The From domain must be VERIFIED on the Resend account or every
# send fails with a 403 that the product cannot show you — password resets and
# invitations both return success before the send is attempted. `npm run doctor`
# checks this; keep it passing.
RESEND_API_KEY=
EMAIL_FROM=Clinicti <system@clinicti.app>
EMAIL_REPLY_TO=

# ------------------------------------------------------- platform alerts
# Worker only. Where to send "the platform itself is broken" mail — a stale
# backup, a queue that stopped draining, a clinic off WhatsApp for half an hour,
# the web app not answering.
#
# Comma-separated. Leave it EMPTY and alerts go to every super-admin account
# instead, which is the safer default: an alerting system that silently does
# nothing because a variable was never set is the exact failure it exists to
# prevent. Set it only to reach an address that is not a super admin — a shared
# ops inbox, or a pager gateway.
#
# Confirm the channel actually delivers with `npm run ops:test` — an alerter
# nobody has received a message from is a belief, not a safeguard.
OPS_ALERT_EMAIL=

# --------------------------------------------------------------- sessions
# Web only. A session already expires 30 days after it is created; this is the
# second limit — how long it may sit UNUSED before it stops working. It is the
# one that matters for a lost laptop or a lifted cookie, because those are
# unattended by definition.
#
# Seven days is chosen against the job: anybody who uses this as part of their
# work touches it within a week, and anybody who does not is barely
# inconvenienced by signing in again. Lower it for a stricter posture; a control
# that trains people to resent it is one they route around.
SESSION_IDLE_DAYS=7

# How long confirming the password stays good for, before actions that hand
# over more than one screen's worth of records (exporting the whole patient
# list). Long enough to do the thing you sat down to do, short enough that a
# machine left unlocked over lunch is not still authorised.
REAUTH_WINDOW_MINUTES=10
