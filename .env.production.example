# Production environment.
#
# Three services, three sets of variables. See DEPLOY.md for the walkthrough.
#   web    → Vercel      (Next.js app)
#   worker → Railway     (WhatsApp, automations, AI, reminders, invoice PDFs)
#   data   → Supabase    (Postgres + file storage)
#
# Anything marked [both] must be IDENTICAL on Vercel and Railway or the two
# services will not trust each other.

# ---------------------------------------------------------------- database
# [both] App connection. Uses the clinicos_app role so RLS applies — never the
# postgres superuser, which would bypass tenant isolation.
# Supabase → Project Settings → Database → Connection string (URI), then swap
# the user/password for clinicos_app.
DATABASE_URL=postgresql://clinicos_app:APP_DB_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Owner connection, used ONLY to run migrations. Do not set this on Vercel.
DATABASE_SUPER_URL=postgresql://postgres:SUPABASE_DB_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Password assigned to the clinicos_app role when migrations run.
# Must match the password inside DATABASE_URL above.
APP_DB_PASSWORD=generate-a-long-random-password

# ------------------------------------------------------------------ urls
# [both] Public address of the web app. The worker fetches invoice print pages
# from here, and booking/invoice links are built from it.
APP_URL=https://your-app.vercel.app

# [both] Public address of the worker. Vercel calls it to render PDFs and to
# start WhatsApp sessions.
WORKER_URL=https://your-worker.up.railway.app

# ---------------------------------------------------------------- secrets
# [both] Shared secret guarding the worker's internal API. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_API_SECRET=

# Signs session cookies. Rotating this logs everyone out. Web only.
SESSION_SECRET=

# --------------------------------------------------------------- storage
# [both] Supabase Storage is S3-compatible. Create a PRIVATE bucket named
# "clinic-files", then Project Settings → Storage → S3 access keys.
# Files are served through the app, which checks clinic membership first —
# the bucket must stay private.
S3_BUCKET=clinic-files
S3_ENDPOINT=https://PROJECT_REF.supabase.co/storage/v1/s3
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------- ai
# Worker only — the AI receptionist runs there. Leave empty to keep the agent
# off; it escalates to staff instead of answering.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---------------------------------------------------------------- push
# [both] Web push. Reuse the keys already in your local .env, or regenerate:
#   npx web-push generate-vapid-keys
# Changing them invalidates every existing subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
