# Local development environment. See README.md for full documentation.
DATABASE_URL=postgres://clinicos_app:clinicos_app@127.0.0.1:5544/clinicos
DATABASE_SUPER_URL=postgres://postgres:postgres@127.0.0.1:5544/clinicos
PG_PORT=5544
APP_URL=http://localhost:3000
WORKER_URL=http://localhost:4020
INTERNAL_API_SECRET=dev-internal-secret-change-in-production
SESSION_SECRET=dev-session-secret-change-in-production
STORAGE_DIR=./storage
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@clinicos.local
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Optional. Overrides the Meta pixel id compiled into components/meta-pixel.
# The pixel loads only on the agency workspace booking page (/book/clinicti);
# next.config grants the Facebook origins on that path alone.
META_PIXEL_ID=

# Optional. Google Sign-In. Web application credentials from the Google Cloud
# console; the authorized redirect URI must be exactly
#   ${APP_URL}/api/auth/google/callback
# Leave either one empty and the button is not rendered at all.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Sign in with Apple. Required by App Store review guideline 4.8 for
# any app that also offers Google sign-in, so these must be set before Clinicti
# can ship on iOS.
#
# All four, or the button is not rendered. From developer.apple.com:
#   APPLE_CLIENT_ID   the SERVICES ID (Identifiers ▸ Services IDs), not the
#                     bundle id. Its "Website URLs" must list your domain and
#                     ${APP_URL}/api/auth/apple/callback as a Return URL.
#   APPLE_TEAM_ID     10 characters, top right of the developer portal.
#   APPLE_KEY_ID      the id of a Keys ▸ Sign in with Apple key.
#   APPLE_PRIVATE_KEY the contents of that key's .p8 file, downloadable ONCE.
#                     Newlines may be written as \n.
#
# This flow cannot run over http: Apple rejects an http return URL, and the
# handshake cookie is SameSite=None, which browsers require to be Secure. Sign
# in with Apple is therefore not testable against localhost — use the deployed
# app, or a tunnel with a real certificate.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
